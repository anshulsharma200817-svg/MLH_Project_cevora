# =============================================================================
# CEVORA PLATFORM — Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# ── Gemma 4 AI (Google AI Studio) ───────────────────────────────────────────
# Get your API key from https://aistudio.google.com/
GEMMA_API_KEY=your_gemma_api_key_here

# Optional: override the Gemma model name (default: gemma-4)
# GEMMA_MODEL=gemma-4

# ── Legacy keys (kept for backward compatibility) ─────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional services ─────────────────────────────────────────────────────────
# Push notifications via ntfy.sh
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=cevora-demo-alerts

# Email via Resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=alerts@your-domain.example
EMAIL_TO=your_recipient_email

# Optional: Supabase (for production database)
NEXT_PUBLIC_SUPABASE_URL=optional
NEXT_PUBLIC_SUPABASE_ANON_KEY=optional

# Optional: LibreTranslate for translation proxy
LIBRETRANSLATE_URL=http://localhost:5000